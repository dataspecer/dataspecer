import React from "react";
import { createRoot } from "react-dom/client";
import CssBaseline from "@mui/material/CssBaseline";
import { ThemeProvider } from "@mui/material/styles";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterLuxon } from "@mui/x-date-pickers/AdapterLuxon";
import { RouterProvider } from "react-router-dom";

import { router } from "./App.tsx";
import { dataSource } from "@/generated/operation-registry.ts";
import { DataSourceProvider } from "@/shared/datasource/data-source-context.tsx";
import { SnackbarProvider } from "@/shared/components/snackbar.tsx";
import { theme } from "./theme.ts";
import "./index.css";

createRoot(document.getElementById("root")!).render(
  <React.StrictMode>
    <ThemeProvider theme={theme} defaultMode="system">
      <CssBaseline />
      <LocalizationProvider dateAdapter={AdapterLuxon} adapterLocale={navigator.language}>
        <DataSourceProvider value={dataSource}>
          <SnackbarProvider>
            <RouterProvider router={router} />
          </SnackbarProvider>
        </DataSourceProvider>
      </LocalizationProvider>
    </ThemeProvider>
  </React.StrictMode>,
);
