import type { AggregateDescriptorMap } from "@/shared/types/aggregate.ts";
<%~ it.aggregates.map((aggregate) => `import { ${aggregate.descriptorName} } from "@/modules/${aggregate.moduleName}/descriptor.ts";`).join("\n") %>

/** Generated aggregate descriptors keyed by aggregate IRI. */
export const aggregateRegistry = {
<%~ it.aggregates.map((aggregate) => `  ${it.json(aggregate.iri)}: ${aggregate.descriptorName},`).join("\n") %>
} satisfies AggregateDescriptorMap;
