import { RdfLdkitDataSource } from "@/shared/data-source/rdf-ldkit-data-source.ts";
<%~ it.aggregates.map((aggregate) => `import { ${aggregate.schemaName} } from "@/modules/${aggregate.moduleName}/ldkit-schema.ts";`).join("\n") %>

export const rdfDataSource = new RdfLdkitDataSource(<%~ it.json(it.model.datasource.endpoint) %>, {
  // key - aggregate IRI, value - schema bundle
<%~ it.aggregates.map((aggregate) => `    ${it.json(aggregate.iri)}: ${aggregate.schemaName},`).join("\n") %>
});
