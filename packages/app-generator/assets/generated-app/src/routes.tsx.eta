import type { RouteDescriptor } from "@/shared/app/route-descriptor.ts";

// lazy route imports keep pages out of the initial bundle
export const routes: RouteDescriptor[] = [
<% it.pages.forEach((page) => { -%>
  {
    id: <%~ it.json(page.operation.routeId) %>,
    path: <%~ it.json(page.operation.path) %>,
    title: <%~ it.json(page.operation.pageTitle) %>,
    operation: <%~ it.json(page.operation.operation) %>,
    lazy: () =>
      import("@/modules/<%= page.moduleName %>/<%= page.fileName %>").then((module) => ({
        Component: module.<%= page.componentName %>,
      })),
  },
<% }) -%>
];
