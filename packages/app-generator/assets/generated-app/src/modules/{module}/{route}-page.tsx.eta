<% if (it.page.operation.operation === "ReadList") { -%>
import { ListView } from "@/shared/components/list-view.tsx";
import { <%= it.page.pageActionsComponentName %>, additionalRowActions } from "./<%= it.page.operation.routeId %>-actions.tsx";
<% } else if (it.page.operation.operation === "ReadDetail") { -%>
import { DetailView } from "@/shared/components/detail-view.tsx";
import { useEntityId } from "@/shared/navigation/use-location.ts";
import { <%= it.page.pageActionsComponentName %> } from "./<%= it.page.operation.routeId %>-actions.tsx";
<% } else if (it.page.operation.operation === "Create") { -%>
import { CreateForm } from "@/shared/components/create-form.tsx";
<% } else if (it.page.operation.operation === "Update") { -%>
import { UpdateForm } from "@/shared/components/update-form.tsx";
import { useEntityId } from "@/shared/navigation/use-location.ts";
<% } else if (it.page.operation.operation === "Delete") { -%>
import { DeleteForm } from "@/shared/components/delete-form.tsx";
import { useEntityId } from "@/shared/navigation/use-location.ts";
<% } -%>
import type { OperationNavigationDescriptor } from "@/shared/navigation/navigation.ts";
import { aggregateRegistry } from "@/config/aggregate-registry.ts";
<% if (it.page.operation.operation === "Create" || it.page.operation.operation === "Update") { -%>
import { instanceBaseIri, languages } from "@/config/app-config.ts";
<% } else { -%>
import { languages } from "@/config/app-config.ts";
<% } -%>
import { <%= it.page.descriptorName %> } from "./descriptor.ts";
import { <%= it.page.operationClassName %> } from "./<%= it.page.operation.routeId %>-operation.ts";

const title = <%~ it.json(it.page.operation.pageTitle) %>;

const navigation: OperationNavigationDescriptor = <%~ it.json(it.page.operation.navigation) %>;

const strategy = new <%= it.page.operationClassName %>();
<% if (it.page.operation.operation === "Delete") { -%>

// composition paths included in cascade deletion
const cascadePaths: readonly string[] = <%~ it.json(it.page.operation.delete?.cascadePaths ?? []) %>;
<% } -%>

export function <%= it.page.componentName %>() {
<% if (it.page.operation.operation === "ReadList") { -%>
  return (
    <ListView
      title={title}
      aggregate={<%= it.page.descriptorName %>}
      aggregateRegistry={aggregateRegistry}
      strategy={strategy}
      navigation={navigation}
      languages={languages}
      additionalPageActions={<%= it.page.pageActionsComponentName %>}
      additionalRowActions={additionalRowActions}
    />
  );
<% } else if (it.page.operation.operation === "ReadDetail") { -%>
  const id = useEntityId();

  return (
    <DetailView
      title={title}
      aggregate={<%= it.page.descriptorName %>}
      aggregateRegistry={aggregateRegistry}
      strategy={strategy}
      navigation={navigation}
      id={id}
      languages={languages}
      additionalPageActions={<%= it.page.pageActionsComponentName %>}
    />
  );
<% } else if (it.page.operation.operation === "Create") { -%>
  return (
    <CreateForm
      title={title}
      aggregate={<%= it.page.descriptorName %>}
      aggregateRegistry={aggregateRegistry}
      strategy={strategy}
      navigation={navigation}
      instanceBaseIri={instanceBaseIri}
      languages={languages}
    />
  );
<% } else if (it.page.operation.operation === "Update") { -%>
  const id = useEntityId();

  return (
    <UpdateForm
      title={title}
      aggregate={<%= it.page.descriptorName %>}
      aggregateRegistry={aggregateRegistry}
      strategy={strategy}
      navigation={navigation}
      instanceBaseIri={instanceBaseIri}
      id={id}
      languages={languages}
    />
  );
<% } else if (it.page.operation.operation === "Delete") { -%>
  const id = useEntityId();

  return (
    <DeleteForm
      title={title}
      languages={languages}
      aggregate={<%= it.page.descriptorName %>}
      aggregateRegistry={aggregateRegistry}
      strategy={strategy}
      navigation={navigation}
      cascadePaths={cascadePaths}
      id={id}
    />
  );
<% } -%>
}
