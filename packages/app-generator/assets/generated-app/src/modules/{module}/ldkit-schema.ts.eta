import type { LdkitSchemaBundle } from "@/shared/data-source/rdf-ldkit-data-source.ts";
<% if (it.aggregate.ldkitSchemaNamespaces.length > 0) { -%>
import { <%~ it.aggregate.ldkitSchemaNamespaces.join(", ") %> } from "ldkit/namespaces";
<% } -%>

// The datasource selects the read or write shape required by the operation and entity target.
export const <%= it.aggregate.schemaName %>: LdkitSchemaBundle = <%~ it.aggregate.ldkitSchemaSource %>;
