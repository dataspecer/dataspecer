import { <%= it.page.strategyBaseName %> } from "@/shared/operations/<%= it.page.strategyModuleName %>.ts";
<% if (it.page.operation.operation === "ReadList") { -%>
import type { ReadListResult } from "@/shared/data-source/data-source.ts";
<% } -%>
import type { OperationContext } from "@/shared/operations/operation-strategy.ts";
import type { OperationResult, ValidationResult } from "@/shared/operations/operation-result.ts";
import type { <%= it.page.modelName %> } from "./model.ts";

export class <%= it.page.operationClassName %> extends <%= it.page.strategyBaseName %><<%= it.page.modelName %>> {
  async validateRequest(
    _ctx: OperationContext<<%= it.page.modelName %>>,
  ): Promise<ValidationResult> {
    return { ok: true, issues: [] };
  }

  async postprocess(
    _ctx: OperationContext<<%= it.page.modelName %>>,
    result: OperationResult<<%~ it.page.resultTypeName %>>,
  ): Promise<OperationResult<<%~ it.page.resultTypeName %>>> {
    return result;
  }
}
