import { Link, Route, Routes } from "react-router-dom";

import { routes } from "./routes.tsx";

export function App() {
  return (
    <main className="app">
      <header className="app-header">
        <h1><%= it.model.app.name %></h1>
        <nav className="site-nav">
          {routes.filter((candidate) => candidate.operation === "ReadList").map((candidate) => (
            <Link key={candidate.id} to={candidate.path}>
              {candidate.title}
            </Link>
          ))}
        </nav>
      </header>
      <Routes>
        {routes.map((route) => (
          <Route key={route.id} path={route.path} element={<route.component />} />
        ))}
        <Route
          path="*"
          element={
            <section>
              <h2>Page not found</h2>
              <p>The requested page does not exist.</p>
            </section>
          }
        />
      </Routes>
    </main>
  );
}
