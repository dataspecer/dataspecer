import { routes } from "./routes.tsx";

export function App() {
  const currentPath = window.location.pathname;
  const route = routes.find((candidate) => matchPath(candidate.path, currentPath));
  const Page = route?.component;

  return (
    <main className="app">
      <header className="app-header">
        <h1><%= it.model.app.name %></h1>
        <nav className="site-nav">
          {routes.filter((candidate) => candidate.operation === "ReadList").map((candidate) => (
            <a key={candidate.id} href={candidate.path}>
              {candidate.title}
            </a>
          ))}
        </nav>
      </header>
      {Page ? (
        <Page />
      ) : (
        <section>
          <h2>Page not found</h2>
          <p>The requested page does not exist.</p>
        </section>
      )}
    </main>
  );
}

function matchPath(routePath: string, currentPath: string): boolean {
  return routePath === currentPath || (currentPath === "/" && routePath === routes[0].path);
}
