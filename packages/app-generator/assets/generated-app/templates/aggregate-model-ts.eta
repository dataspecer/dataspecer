import type { EntityModel } from "../../shared/types/aggregate.ts";

<% it.aggregate.nestedModels.forEach((model) => { -%>
export interface <%= model.name %> extends EntityModel {
<% model.fields.forEach((field) => { -%>
  <%~ field.modelDeclaration %>;
<% }) -%>
}

<% }) -%>
export interface <%= it.aggregate.modelName %> extends EntityModel {
<% it.aggregate.fields.forEach((field) => { -%>
  <%~ field.modelDeclaration %>;
<% }) -%>
}

export function createEmpty<%= it.aggregate.modelName %>(): Partial<<%= it.aggregate.modelName %>> {
  return {
<% it.aggregate.fields.filter((field) => field.many).forEach((field) => { -%>
    <%= field.propertyName %>: [],
<% }) -%>
  };
}
