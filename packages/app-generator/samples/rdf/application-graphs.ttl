g:books a ag:ApplicationGraph ;
  ag:name "Book library" ;
  ag:dataSpecificationIri "5dafc08e-fab8-4c84-9631-9e5ab8e3b3a5" ;
  ag:datasources ds:local ;
  ag:nodes n:books-list, n:books-detail ;
  ag:edges e:books-list-to-detail .

ds:staging a ag:DataSource ;
  ag:datasourceIdentifier "staging" ;
  ag:datasourceType dt:rdf ;
  ag:endpoint "https://staging.example.org/sparql"^^xsd:anyURI .

n:books-list a ag:Node ;
  ag:nodeIdentifier "books.list" ;
  ag:aggregateIri "d4b5b211-d440-42b6-b82c-97fa7d14628b" ;
  ag:operation op:ReadList ;
  ag:config cfg:books-list .

cfg:books-list a ag:NodeConfiguration ; ag:pageTitle "Books" .

n:books-detail a ag:Node ;
  ag:nodeIdentifier "books.detail" ;
  ag:aggregateIri "0cb8193e-6dc1-4365-8318-074b4e0fb97c" ;
  ag:operation op:ReadDetail .

e:books-list-to-detail a ag:Edge ; ag:edgeIdentifier "books-list-to-detail" ;
  ag:source n:books-list ; ag:target n:books-detail ; ag:edgeType et:transition .
