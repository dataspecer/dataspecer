del:nodes-config-cascade a ag:DeleteSetting ; ag:deletePath "nodes.config" ; ag:deletePolicy dp:cascade .
del:nodes-config-associations-cascade a ag:DeleteSetting ; ag:deletePath "nodes.config.associations" ; ag:deletePolicy dp:cascade .
del:nodes-config-deleteRules-cascade a ag:DeleteSetting ; ag:deletePath "nodes.config.deleteRules" ; ag:deletePolicy dp:cascade .
del:edges-cascade a ag:DeleteSetting ; ag:deletePath "edges" ; ag:deletePolicy dp:cascade .
as:type-aggregation a ag:AssociationSetting ; ag:associationPath "type" ; ag:associationKind ak:aggregation .
as:operation-aggregation a ag:AssociationSetting ; ag:associationPath "operation" ; ag:associationKind ak:aggregation .
as:config-composition a ag:AssociationSetting ; ag:associationPath "config" ; ag:associationKind ak:composition .
