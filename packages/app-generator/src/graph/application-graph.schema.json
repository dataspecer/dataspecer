{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/dataspecer/dataspecer/main/packages/app-generator/src/graph/application-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "dataSpecificationIri", "datasources", "nodes", "edges"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dataSpecificationIri": {
      "type": "string",
      "minLength": 1
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "endpoint"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["rdf"]
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "aggregateIri", "operation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "aggregateIri": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "enum": ["Create", "ReadList", "ReadDetail", "Update", "Delete"]
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pageTitle": {
                "type": "string",
                "minLength": 1
              },
              "associations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": ["composition", "aggregation"]
                }
              },
              "delete": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": ["cascade"]
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["transition", "redirect"]
          }
        }
      }
    }
  }
}
