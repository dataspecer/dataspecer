{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["assets/generated-app/**/*.ts", "assets/generated-app/**/*.tsx"],
  "exclude": ["node_modules"]
}
